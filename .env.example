# ==============================================================================
# Fapriv Environment Variables Template
# Copy this file to .env or .env.local and fill in your actual credentials.
# NOTE: Never commit your actual .env file or private keys into source control!
# ==============================================================================

# Supabase Settings (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Application Settings
VITE_APP_NAME=Fapriv
VITE_APP_URL=http://localhost:5173
